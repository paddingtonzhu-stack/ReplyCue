# Copy this file to .env. The real .env is ignored by Git.
OPENAI_API_KEY=your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512

# A conversation uses RAG after either threshold is reached.
RAG_MESSAGE_THRESHOLD=80
RAG_CHARACTER_THRESHOLD=24000
DIRECT_CONTEXT_MESSAGES=80
RAG_RECENT_MESSAGES=12
RAG_TOP_K=8
